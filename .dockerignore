.git
.gitignore
.venv
venv
__pycache__
*.pyc
.pytest_cache
.vscode
.claude

# Model weights are synced from GCS at runtime, never baked into an image.
model_store/model_weights/
model_store/hemolysis_predictor_v2/*
!model_store/hemolysis_predictor_v2/__init__.py
!model_store/hemolysis_predictor_v2/predictor.py

# Local run artifacts, not part of either image.
artifacts/
data/raw/
configs/runs/
configs/test_cases/
configs/base.yaml
configs/test_run.yaml

.env
.env.example
README.md
docs/

# The web build runs `npm ci` from the lockfile INSIDE the image (deploy/web.Dockerfile), so a
# host node_modules is 125MB of build context that is copied and then thrown away -- and if it
# were copied over the installed tree it would defeat the point of installing from the lockfile.
node_modules/
web/dist/
web/*.tsbuildinfo

# deploy/.env holds the real settings and the signing key. It must never enter an image; compose
# passes configuration as environment variables instead.
deploy/.env
