# read at services/accounts/accounts/config.py:123
PEPTIDE_UPSTREAM=


# ── Connection ──
# Optional, not required: the port the job API's own `python -m backend.api_e2e.api`
# listens on (src/backend/api_e2e/api.py). Defaults to 8080 when unset, which is what
# PEPTIDE_UPSTREAM above defaults to -- change one and you must change the other.
PORT=8080

