# Copy to deploy/.env (which is gitignored) and fill in. NEVER commit a filled-in copy.
#
#   cp deploy/.env.example deploy/.env
#   docker compose -f deploy/compose.yaml --env-file deploy/.env up -d --build

# ---------- Accounts service ----------

# REQUIRED. At least 32 bytes. Generate one with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
# Changing it signs every user out. In production keep it in Secret Manager, not in this file.
ACCOUNTS_SECRET_KEY=

# ---------- Where the app is served ----------

# Loopback by default; 0.0.0.0 serves other machines. Put TLS in front before you do that.
WEB_BIND=127.0.0.1
WEB_PORT=8088

# ---------- Job API: Vertex AI and Cloud Storage ----------
# Every one of these is required. The API answers 503 to a job submission while any is missing,
# and GET /healthz lists which are absent.

VERTEX_CLOUD_PROJECT=
VERTEX_LOCATION=us-central1
VERTEX_ARTIFACTS_DIR=gs://<your-bucket>/artifacts
SEED_CANDIDATES_FILE=gs://<your-bucket>/curated_peptides.fasta
WORKER_IMAGE_URI=<region>-docker.pkg.dev/<project>/<repository>/worker-e2e:<tag>
WORKER_SERVICE_ACCOUNT=<worker-runtime>@<project>.iam.gserviceaccount.com

# Required pairing: NVIDIA_L4 only attaches to g2-standard-*. The ProtGPT2 route loads its base
# model 4-bit (NF4) via bitsandbytes, which needs an Ampere-or-newer GPU; on a T4 it can silently
# fall back to CPU rather than raise.
MACHINE_TYPE=g2-standard-4
ACCELERATOR_TYPE=NVIDIA_L4
ACCELERATOR_COUNT=1

# Forwarded into the worker container, which syncs model weights from it. If it is missing the
# worker falls back to a placeholder bucket and fails during weight sync, minutes into a GPU run.
VERTEX_MODEL_STORE=gs://<your-bucket>/model_weights

# ---------- Credentials ----------
# ON A GCP VM created with --scopes=cloud-platform, leave BOTH of these empty: the metadata
# server supplies Application Default Credentials and nothing is mounted.
#
# OFF GCP, point GOOGLE_CREDENTIALS_FILE at a service-account key on the host; compose mounts it
# read-only at /secrets/credentials.json, which is what the other variable must then name.
#
# The file must be READABLE BY UID 10001, the non-root user the API container runs as. A bind
# mount keeps the host's ownership, so a key written by gcloud (mode 0600, owned by you) is not
# readable inside the container and every Google call answers 500. See docs/DEPLOYMENT.md.
GOOGLE_CREDENTIALS_FILE=
GOOGLE_APPLICATION_CREDENTIALS=
