# Copy to deploy/cloudrun/env.sh (gitignored) and fill in, then:
#   source deploy/cloudrun/env.sh
#   deploy/cloudrun/deploy.sh
#
# NEVER commit a filled-in copy.

# ---- Identity / destination ----------------------------------------------------
export PROJECT=
export REGION=us-central1
export SERVICE=peptide-api
export AR_REPO=peptide

# ---- Required API settings -----------------------------------------------------
export VERTEX_CLOUD_PROJECT=            # defaults to $PROJECT if left empty
export VERTEX_LOCATION=us-central1      # defaults to $REGION if left empty
export VERTEX_ARTIFACTS_DIR=gs://<bucket>/artifacts
export VERTEX_MODEL_STORE=gs://<bucket>/model_weights
export SEED_CANDIDATES_FILE=gs://<bucket>/curated_peptides.fasta
export WORKER_IMAGE_URI=<region>-docker.pkg.dev/<project>/<repository>/worker-e2e:<tag>
export WORKER_SERVICE_ACCOUNT=<worker-runtime>@<project>.iam.gserviceaccount.com

# Required pairing: NVIDIA_L4 only attaches to g2-standard-*.
export MACHINE_TYPE=g2-standard-4
export ACCELERATOR_TYPE=NVIDIA_L4
export ACCELERATOR_COUNT=1

# ---- Identity of the Cloud Run service (ADC) -----------------------------------
# Needs roles/aiplatform.user (Vertex Custom Jobs) and GCS write on the artifacts
# bucket. Empty = project default compute service account.
export API_SERVICE_ACCOUNT=

# ---- Ingress / auth ------------------------------------------------------------
# internal-and-cloud-load-balancing (recommended) | internal | all
export INGRESS=internal-and-cloud-load-balancing
# true  = Cloud Run does its own IAM check is OFF; your proxy owns auth.
# false = Cloud Run requires a Google identity (IAP / SA token from your proxy).
export ALLOW_UNAUTH=true
