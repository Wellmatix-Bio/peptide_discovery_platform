      "E2ERequest": {
        "additionalProperties": false,
        "description": "The public e2e job request shape: one field per client-configurable\nstage, each stage's own params flattened together with its `enabled`\nflag (no {\"params\": {...}} wrapper). Every field is required to be\npresent (a bare {} accepts that stage's defaults) so the OpenAPI schema\nand pydantic validation reflect the real per-stage shape directly,\ninstead of a generic dict a stage name could otherwise be mismatched\nagainst. s02_wound_biology_and_targets, s03_data_integration, and\ns11_ranking are deliberately absent -- e2e_config.py always overrides\nthem itself (s02/s03 force-disabled, s11 force-default), so nothing a\nclient sends for them would ever be used.",
        "properties": {
          "s01_therapeutic_product_brief": {
            "$ref": "#/components/schemas/Stage1Request"
          },
          "s04_candidate_generation": {
            "$ref": "#/components/schemas/Stage4Request"
          },
          "s05_physchem_screening": {
            "$ref": "#/components/schemas/Stage5Request"
          },
          "s06_functional_models": {
            "$ref": "#/components/schemas/Stage6Request"
          },
          "s07_structure_mechanism": {
            "$ref": "#/components/schemas/Stage7Request"
          },
          "s08_safety_developability": {
            "$ref": "#/components/schemas/Stage8Request"
          },
          "s09_synthesis_cmc": {
            "$ref": "#/components/schemas/Stage9Request"
          }
        },
        "required": [
          "s01_therapeutic_product_brief",
          "s04_candidate_generation",
          "s05_physchem_screening",
          "s06_functional_models",
          "s07_structure_mechanism",
          "s08_safety_developability",
          "s09_synthesis_cmc"
        ],
        "title": "E2ERequest",
        "type": "object"
      },
