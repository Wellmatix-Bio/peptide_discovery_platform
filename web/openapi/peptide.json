          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Job Results"
      }
    },
    "/api/v1/jobs/{job_id}/status": {
      "get": {
        "operationId": "get_job_status_api_v1_jobs__job_id__status_get",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "title": "Job Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobStatusResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Job Status"
      }
    },
    "/api/v1/models": {
      "get": {
        "description": "What this deployment declares it will run, read from model_store/ on disk.\n\nHONEST LIMITS, because a provenance endpoint that overstates is worse than none:\n- `predictor_sha256` digests the predictor's CODE (predictor.py), not its weights. The API\n  container does not hold the weights at all -- the worker syncs them from\n  VERTEX_MODEL_STORE at run time -- so this process cannot digest them without downloading\n  them, which a status endpoint has no business doing.\n- `version` is the suffix of the directory name, which is how this project versions a\n  predictor. It is not derived from the weights either.\n- `model_card` is whatever the predictor ships. 7 of the 15 predictors ship none, and\n  `model_card_present` says which, rather than an empty object implying there is nothing\n  to know.",
        "operationId": "model_manifest_api_v1_models_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelManifest"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Model Manifest"
      }
    },
    "/healthz": {
      "get": {
        "description": "Liveness only. It deliberately does NOT check Vertex or GCS: a readiness probe that\ncalls out to Google turns a Google incident into an unhealthy container, and this process\nis perfectly able to answer 503s explaining itself. Whether the settings are present is\nreported here as a fact rather than as health.",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Healthz"
      }
    }
  }
}
