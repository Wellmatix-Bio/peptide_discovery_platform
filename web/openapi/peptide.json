{
  "components": {
    "schemas": {
      "BriefFields": {
        "properties": {
          "desired_functions": {
            "description": "Desired functions of the therapeutic product",
            "items": {
              "enum": [
                "angiogenesis",
                "anti_inflammatory",
                "antimicrobial",
                "cell_proliferation/migration",
                "collagen_remodeling",
                "collagen_synthesis",
                "fibroblast_migration",
                "immunomodulation",
                "keratinocyte_migration"
              ],
              "type": "string"
            },
            "title": "Desired Functions",
            "type": "array"
          },
          "dosing_interval_hours": {
            "maximum": 168.0,
            "minimum": 1.0,
            "title": "Dosing Interval Hours",
            "type": "integer"
          },
          "max_length": {
            "maximum": 50.0,
            "minimum": 6.0,
            "title": "Max Length",
            "type": "integer"
          },
          "min_length": {
            "maximum": 50.0,
            "minimum": 6.0,
            "title": "Min Length",
            "type": "integer"
          },
          "pathogens": {
            "items": {
              "enum": [
                "Escherichia_coli",
                "Staphylococcus_aureus",
                "Pseudomonas_aeruginosa"
              ],
              "type": "string"
            },
            "title": "Pathogens",
            "type": "array"
          },
          "wound_context": {
            "description": "Context of the wound",
            "items": {
              "enum": [
                "acute",
                "biofilm_positive",
                "burn",
                "chronic",
                "diabetic",
                "high_glucose",
                "infected",
                "ischemic",
                "low_perfusion",
                "necrotic",
                "surgical",
                "traumatic"
              ],
              "type": "string"
            },
            "title": "Wound Context",
            "type": "array"
          }
        },
        "required": [
          "wound_context",
          "desired_functions",
          "pathogens",
          "min_length",
          "max_length",
          "dosing_interval_hours"
        ],
        "title": "BriefFields",
        "type": "object"
      },
